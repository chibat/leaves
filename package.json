{
  "name": "leaves",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 8000",
    "build": "vite build",
    "build:cli": "tsc cli-package/src/cli.ts --target ES2022 --module NodeNext --moduleResolution NodeNext --types node --skipLibCheck --outDir cli-package --rootDir cli-package/src",
    "preview": "vite preview --host 0.0.0.0 --port 8000",
    "check": "void prepare && tsc --noEmit",
    "cli": "node --experimental-strip-types cli-package/src/cli.ts",
    "test": "node --experimental-strip-types --test src/server/query_builder_test.ts",
    "sb-gen": "set -a && . ./.env && set +a && : \"${SUPABASE_PROJECT_ID:?SUPABASE_PROJECT_ID must be set in .env}\" && supabase gen types typescript --project-id \"$SUPABASE_PROJECT_ID\" > src/server/database.types.ts",
    "deploy": "void deploy --platform cloudflare",
    "upload": "npm run build && node scripts/upload-staging.mjs"
  },
  "dependencies": {
    "@void/react": "1.12.2",
    "@supabase/supabase-js": "^2.38.4",
    "github-markdown-css": "^5.9.0",
    "highlight.js": "^11.11.1",
    "marked": "^4.2.12",
    "mousetrap": "^1.6.5",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sanitize-html": "^2.8.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/marked": "^4.3.2",
    "@types/mousetrap": "^1.6.15",
    "@types/node": "^22.15.30",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/sanitize-html": "^2.16.0",
    "typescript": "^5.8.3",
    "vite": "^8.0.0",
    "void": "1.12.2",
    "wrangler": "^4.21.0"
  }
}