{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "verbatimModuleSyntax": false,
    "allowImportingTsExtensions": true,
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["void/env", "node"],
    "paths": {
      "~/*": [
        "./src/*"
      ]
    }
  },
  "include": [
    ".void/**/*.d.ts",
    "vite.config.ts",
    "void.config.ts",
    "src/**/*"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ]
}