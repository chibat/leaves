---
import Layout from "../layouts/Layout.astro";
import PageFrame from "../components/PageFrame.astro";
import { getSession } from "~/server/auth.ts";

const session = await getSession(Astro.request);
const authUrl = session ? undefined : "/auth";
---

<Layout title="Terms of Service - Leaves">
  <PageFrame user={session?.user} authUrl={authUrl}>
    <main class="container">
      <h1>Terms of Service</h1>
      <p>
        These Terms of Service (the "Terms") govern your use of Leaves (the "Service"), provided by chibat (the "Operator"). Please use the Service only after agreeing to these Terms.
      </p>

      <h2>1. The Service</h2>
      <p>
        The Service is a microblogging platform that allows users to sign in with a Google account and create Markdown posts, comment, follow other users, and like posts. The Operator may change the Service without prior notice.
      </p>

      <h2>2. Accounts</h2>
      <ul>
        <li>
          You must use a Google account that you control to access the Service.
        </li>
        <li>You are responsible for managing your account.</li>
        <li>You may delete your account at any time from the Settings page.</li>
      </ul>

      <h2>3. User Content</h2>
      <ul>
        <li>
          You are responsible for the posts, comments, and other content you create.
        </li>
        <li>
          Posts set to public may be viewed by other users and third parties on the internet. Drafts are not public, but may be viewed by others if you change their visibility to public.
        </li>
        <li>
          You grant the Operator permission to use your content to the extent necessary to display and distribute it through the Service.
        </li>
        <li>
          The Operator does not guarantee that your content will be backed up. Please keep your own copies of any content you need.
        </li>
        <li>
          The Operator does not guarantee complete confidentiality or security for private content, including drafts. The Operator is not responsible if such content is disclosed or accessed as a result of unauthorized access by a third party or other circumstances not attributable to the Operator.
        </li>
      </ul>

      <h2>4. Prohibited Conduct</h2>
      <p>You must not:</p>
      <ul>
        <li>violate any law or public policy;</li>
        <li>infringe on another person's rights, privacy, or reputation;</li>
        <li>
          gain unauthorized access to, interfere with, or place excessive load on the Service; or
        </li>
        <li>impersonate others, send spam, or engage in any other conduct the Operator considers inappropriate.</li>
      </ul>

      <h2>5. Content Removal and Account Restrictions</h2>
      <p>
        If you violate these Terms, or if the Operator considers it necessary to operate the Service, the Operator may remove content, restrict account access, or take other necessary measures.
      </p>

      <h2>6. Disclaimer</h2>
      <p>
        The Operator does not warrant the accuracy, completeness, availability, or fitness for a particular purpose of the Service. The Operator is not liable for any damages you incur as a result of using or being unable to use the Service.
      </p>

      <h2>7. Changes to These Terms</h2>
      <p>
        The Operator may revise these Terms as necessary. Revised Terms take effect when posted on this page.
      </p>

      <h2>8. Governing Law and Jurisdiction</h2>
      <p>
        These Terms are governed by the laws of Japan. Any dispute between you and the Operator concerning the Service will be subject to the exclusive jurisdiction, as the court of first instance, of the court with jurisdiction over the Operator's location.
      </p>

      <p class="text-muted">Effective date: November 14, 2026</p>
    </main>
  </PageFrame>
</Layout>
