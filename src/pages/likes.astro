---
import Layout from "../layouts/Layout.astro";
import PageFrame from "../components/PageFrame.astro";
import LikePosts from "~/islands/LikePosts.tsx";
import { getSession } from "~/server/auth.ts";
import { getPagePosts } from "~/server/page_posts.ts";

const session = await getSession(Astro.request);
if (!session) return Astro.redirect("/", 307);
const posts = await getPagePosts(session, { liked: true });
---

<Layout title="Likes - Leaves">
  <PageFrame user={session.user}>
    <main class="container">
      <LikePosts loginUserId={session.user.id} initialPosts={posts} client:load />
    </main>
  </PageFrame>
</Layout>
