---
import Layout from "../../layouts/Layout.astro";
import PageFrame from "../../components/PageFrame.astro";
import PostNew from "~/islands/PostNew.tsx";
import { getAuthUrl, getSession } from "~/server/auth.ts";

const session = await getSession(Astro.request);
if (!session) return Astro.redirect(getAuthUrl(Astro.request.url));
---

<Layout title="New - Leaves">
  <PageFrame user={session.user}>
    <main class="container">
      <h1>New Post</h1>
      <PostNew client:load />
    </main>
  </PageFrame>
</Layout>
