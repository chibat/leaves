---
import Layout from "../../layouts/Layout.astro";
import { selectUserPostIds } from "~/server/db.ts";

const userId = Number(Astro.params.userId);
if (!Number.isSafeInteger(userId) || userId <= 0) {
  return new Response("Not Found", { status: 404 });
}
const postIds = await selectUserPostIds(userId);
---

<Layout title="Sitemap Posts - Leaves">
  <main class="container" style="word-break: break-word">
    <h1>Sitemap Posts</h1>
    {postIds.map((postId) => <><a href={`/posts/${postId}`}>{postId}</a>&nbsp;</>)}
  </main>
</Layout>
